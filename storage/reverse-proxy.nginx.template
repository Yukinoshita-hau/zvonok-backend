# PREPARED ONLY: no proxy is deployed and no listener/DNS/router rule is created.
# Requires a proxy on zvonok-net and operator-approved HTTPS hostname/certificates.
# Include in nginx http context. Replace __...__ placeholders before nginx -t.
log_format zvonok_storage_safe '$request_method $uri $status $body_bytes_sent $request_time';
server {
    listen 443 ssl;
    server_name __APPROVED_STORAGE_HOST__;
    ssl_certificate __STORAGE_CERT_CHAIN_FILE__;
    ssl_certificate_key __STORAGE_CERT_KEY_FILE__;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Log path only, never presigned query parameters or authorization headers.
    access_log /var/log/nginx/storage-access.log zvonok_storage_safe;
    # Standard request-error messages can contain the raw signed URL.
    error_log /dev/null crit;
    client_max_body_size 55m;

    location = /zvonok-data { return 403; }
    location = /zvonok-data/ { return 403; }
    location ^~ /zvonok-data/ {
        limit_except GET HEAD OPTIONS { deny all; }
        # shortcut: upstream DNS resolves at startup, reload proxy after RustFS container replacement.
        # No URI suffix, rewrite, redirects or query manipulation: preserve SigV4 input.
        proxy_pass http://zvonok-local-s3:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        send_timeout 180s;
        # Range/If-Range and S3 CORS/206/416 headers pass through unchanged.
        # Do not add wildcard CORS or hide Content-Range here.
    }
    # No console, admin/RPC API, health, generic S3 root or bucket-list routes.
    location / { return 403; }
}
